# ─── DEV environment ────────────────────────────────────────────────────────
# Copy this file to application-dev.properties and fill in real values.
# application-dev.properties is gitignored — never commit real credentials.

# ── Kafka ────────────────────────────────────────────────────────────────────
spring.kafka.bootstrap-servers=your-kafka-broker1:9092,your-kafka-broker2:9092,your-kafka-broker3:9092
spring.kafka.consumer.group-id=your-consumer-group-id

app.kafka.topic=your-kafka-topic
app.kafka.auto-offset-reset=earliest

# For local testing without Kerberos, use SSL only and leave SASL fields blank
app.kafka.security-protocol=SSL
app.kafka.sasl-mechanism=
app.kafka.sasl-kerberos-service-name=
app.kafka.sasl-kerberos-principal=
app.kafka.keytab-file=
app.kafka.krb5-conf=

app.kafka.ssl-ca-location=resources/kafka/dev/common.pem
app.kafka.session-timeout-ms=30000
app.kafka.heartbeat-interval-ms=10000
app.kafka.max-poll-interval-ms=300000

# ── Oracle ───────────────────────────────────────────────────────────────────
spring.datasource.url=jdbc:oracle:thin:@your-oracle-host:1521/your-service-name
spring.datasource.username=your-oracle-username
spring.datasource.password=your-oracle-password
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

app.oracle.table=your-table-name
app.oracle.payload-column=DAMSRESPONSETEXT

# ── App ──────────────────────────────────────────────────────────────────────
# Dot-notation path to the reference ID in the parsed XML.
# Jackson preserves namespace prefixes, so use the same path as the Python version.
app.reference-id-path=ns2:Envelope.ns2:body.PAReferenceId
app.max-messages-per-run=10000
app.poll-timeout-seconds=5
app.empty-polls-before-exit=3
